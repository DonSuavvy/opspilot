# Copy to .env.local and fill in. Never commit .env.local.

# Postgres connection string.
#   Neon (production):  postgres://user:pass@ep-xxx.region.aws.neon.tech/opspilot?sslmode=require
#   Local (Docker):     postgres://opspilot:opspilot@localhost:5434/opspilot
# The driver is selected automatically from the host — see src/db/client.ts.
DATABASE_URL=

# Anthropic API key. Day 2+ (agent loop). Not required for Day 1.
ANTHROPIC_API_KEY=

# Global kill switch. Set to "true" to pause all agent intake.
OPSPILOT_KILL_SWITCH=false

# Daily spend cap in USD. Intake pauses with an honest banner when exceeded.
OPSPILOT_DAILY_BUDGET_USD=5.00
