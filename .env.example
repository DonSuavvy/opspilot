# Copy to .env.local and fill in. Never commit .env.local.

# Postgres connection string.
# Defaults to the local Docker Postgres from docker-compose.yml, so
# `cp .env.example .env.local && npm run db:up` works with no editing.
# For Neon, replace with the pooled connection string:
#   postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/opspilot?sslmode=verify-full
# TLS is selected automatically from the host — see src/db/client.ts.
DATABASE_URL=postgres://opspilot:opspilot@localhost:5434/opspilot

# Anthropic API key. Day 2+ (agent loop). Not required for Day 1.
ANTHROPIC_API_KEY=

# Global kill switch. Set to "true" to pause all agent intake.
OPSPILOT_KILL_SWITCH=false

# Daily spend cap in USD. Intake pauses with an honest banner when exceeded.
OPSPILOT_DAILY_BUDGET_USD=5.00
