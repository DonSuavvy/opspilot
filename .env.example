# Copy to .env.local and fill in. Never commit .env.local.

# Postgres connection string.
# Defaults to the local Docker Postgres from docker-compose.yml, so
# `cp .env.example .env.local && npm run db:up` works with no editing.
# For Neon, replace with the pooled connection string:
#   postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/opspilot?sslmode=verify-full
# TLS is selected automatically from the host — see src/db/client.ts.
DATABASE_URL=postgres://opspilot:opspilot@localhost:5434/opspilot

# Anthropic API key. Day 2+ (agent loop). Not required for Day 1.
ANTHROPIC_API_KEY=

# Global kill switch. Set to "true" to pause all agent intake.
OPSPILOT_KILL_SWITCH=false

# Daily spend cap in USD, summed across every sandbox. Intake pauses with an
# honest banner when it is reached.
OPSPILOT_DAILY_BUDGET_USD=5.00

# Runs one sandbox may start in any 60 seconds. Optional; defaults to 10.
OPSPILOT_RUNS_PER_MINUTE=10

# Runs every sandbox together may start in the same window. Optional; defaults
# to 20. This is the one the shared Bedrock account actually feels, and the one
# that still means something when a visitor can mint a sandbox per cookie.
OPSPILOT_GLOBAL_RUNS_PER_MINUTE=20

# Shared secret for GET /api/cron/cleanup, which sweeps expired sandboxes and
# keeps the Neon branch awake. Vercel sends it as `Authorization: Bearer <this>`
# and sets it for you when you add a cron. Leave it blank locally: the endpoint
# answers 500 and refuses to run rather than opening without one.
CRON_SECRET=
